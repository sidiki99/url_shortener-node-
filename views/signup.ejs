<body>

<h1>SignUp</h1>

<form method="POST" action="/user">
  <label for="url">Enter Name</label>
  <input type="text" id="url" name="name" placeholder="Enter your Name">

  <label for="url">Enter Email</label>
  <input type="text" id="url" name="email" placeholder="Enter your Email">

  <label for="url">Enter Password</label>
  <input type="text" id="url" name="password" placeholder="Enter your Password">

  <button type="submit">Signup</button>
</form>

  
